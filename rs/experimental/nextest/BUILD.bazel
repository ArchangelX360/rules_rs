load("@bazel_lib//:bzl_library.bzl", "bzl_library")

package(default_visibility = ["//visibility:private"])

# Build-wide override of the cargo-nextest binary, e.g.
# --@rules_rs//rs/experimental/nextest:nextest_binary=//my:cargo-nextest
label_flag(
    name = "nextest_binary",
    build_setting_default = "//rs/experimental/nextest/private/platform_config:cargo_nextest",
    visibility = ["//visibility:public"],
)

bzl_library(
    name = "defs",
    srcs = ["defs.bzl"],
    visibility = ["//visibility:public"],
    deps = [
        "//rs/experimental/nextest/private:macro",
        "//rs/experimental/nextest/private:nextest_test",
    ],
)
