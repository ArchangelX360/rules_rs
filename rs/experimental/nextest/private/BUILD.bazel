load("@bazel_lib//:bzl_library.bzl", "bzl_library")
load("//rs:rust_binary.bzl", "rust_binary")
load(":metadata_test.bzl", "nextest_metadata_tests")

package(default_visibility = ["//rs/experimental/nextest:__subpackages__"])

# The test driver. Built for the target platform, since it runs as the test, and shared by
# every nextest_test target rather than recompiled per target.
rust_binary(
    name = "nextest_bazel_runner",
    srcs = ["nextest_bazel_runner.rs"],
    crate_name = "nextest_bazel_runner",
    edition = "2024",
    visibility = ["//visibility:public"],
)

bzl_library(
    name = "metadata",
    srcs = ["metadata.bzl"],
    deps = [":constants"],
)

bzl_library(
    name = "nextest_test",
    srcs = ["nextest_test.bzl"],
    deps = [
        ":constants",
        ":metadata",
        "@rules_rust//rust:bzl_lib",
        "@rules_rust//rust/private:bzl_lib",
    ],
)

bzl_library(
    name = "macro",
    srcs = ["macro.bzl"],
    deps = [
        ":nextest_test",
        "@rules_rust//rust:bzl_lib",
    ],
)

nextest_metadata_tests()

bzl_library(
    name = "constants",
    srcs = ["constants.bzl"],
)
